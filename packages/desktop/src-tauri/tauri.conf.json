{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apollo",
  "version": "0.2.0-alpha.9",
  "identifier": "es.archic.apollo",
  "build": {
    "frontendDist": "../shell"
  },
  "app": {
    "windows": [
      {
        "title": "Apollo",
        "width": 1440,
        "height": 920,
        "minWidth": 980,
        "minHeight": 680,
        "url": "http://127.0.0.1:4317"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:4317; connect-src 'self' http://127.0.0.1:4317; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"],
    "resources": {
      "../runtime/apollo-runtime.cjs": "runtime/apollo-runtime.cjs",
      "../runtime/node": "runtime/node",
      "../runtime/runtime.json": "runtime/runtime.json"
    },
    "targets": ["deb", "appimage"],
    "category": "DeveloperTool",
    "shortDescription": "Verified local AI missions"
  }
}
