{
  "name": "apollo",
  "version": "0.2.0-alpha.7",
  "private": true,
  "description": "Apollo — a local-first AI harness with an explainable autorouter, verified pipelines, and Midas memory. Part of Archic.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vornicx/apollo-agent.git"
  },
  "bugs": "https://github.com/vornicx/apollo-agent/issues",
  "homepage": "https://github.com/vornicx/apollo-agent",
  "type": "module",
  "bin": {
    "apollo": "bin/apollo.js"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "apollo": "tsx packages/cli/src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:runtime": "node packages/desktop/scripts/stage-runtime.mjs",
    "build:desktop": "npm run build -w @archic/apollo-desktop",
    "check:version": "node scripts/check-version.mjs",
    "verify": "npm run check:version && npm run typecheck && npm test && npm run build:runtime && cargo check --locked --manifest-path packages/desktop/src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
