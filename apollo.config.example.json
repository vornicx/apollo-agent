{
  "providers": {
    "anthropic": { "apiKeyEnv": "ANTHROPIC_API_KEY" },
    "openai": { "apiKeyEnv": "OPENAI_API_KEY" },
    "google": { "apiKeyEnv": "GEMINI_API_KEY" },
    "ollama": { "baseUrl": "http://localhost:11434" }
  },
  "models": {
    "register": [
      {
        "id": "ollama/dolphin-mistral-7b",
        "nativeId": "dolphin-mistral:7b",
        "provider": "ollama",
        "displayName": "Dolphin Mistral 7B (local)",
        "contextWindow": 32768,
        "maxOutputTokens": 8000,
        "capabilities": { "writing": 0.4, "reasoning": 0.35, "code": 0.3, "tool-use": 0.3 },
        "cost": { "inputPerMTok": 0, "outputPerMTok": 0 },
        "latency": { "ttftMs": 300, "tokensPerSec": 40 },
        "notes": "Example local model — replace with what `ollama list` shows on your machine."
      }
    ],
    "update": {
      "openai/gpt-5.1": { "cost": { "inputPerMTok": 1.25, "outputPerMTok": 10 } }
    }
  },
  "policy": {
    "maxCostPerTask": 0.5
  },
  "midas": {
    "command": "midas-mcp",
    "args": []
  }
}
